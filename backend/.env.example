# PostgreSQL Database Configuration (Supabase Session Pooler)
DATABASE_HOST=aws-0-ap-south-1.pooler.supabase.com
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=your_database_password_here
DATABASE_SSLMODE=require

# Administrative Operations
ADMIN_API_KEY=your_admin_secret_api_key_here

# ElevenLabs Speech-to-Text Configuration
# Sign up at https://elevenlabs.io to obtain an API key
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_MODEL_ID=scribe_v2
ELEVENLABS_MAX_AUDIO_SIZE_MB=25
